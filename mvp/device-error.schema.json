{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Okanegachi v1 device error",
  "type": "object",
  "properties": {
    "api_version": {
      "const": 1
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "BAD_REQUEST",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "ACK_OUT_OF_RANGE",
            "RESET_REQUIRED",
            "RATE_LIMITED",
            "UPDATE_REQUIRED",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "current_epoch": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "current_epoch",
        "retry_after_ms"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "RESET_REQUIRED"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "current_epoch": {
                "$ref": "#/$defs/uuid"
              }
            }
          },
          "else": {
            "properties": {
              "current_epoch": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "RATE_LIMITED"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retry_after_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          },
          "else": {
            "properties": {
              "retry_after_ms": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "api_version",
    "request_id",
    "error"
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
