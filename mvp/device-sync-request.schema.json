{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Okanegachi v1 device sync request",
  "type": "object",
  "properties": {
    "api_version": {
      "const": 1
    },
    "request_id": {
      "$ref": "#/$defs/uuid"
    },
    "device_id": {
      "$ref": "#/$defs/uuid"
    },
    "epoch": {
      "anyOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "ack_command_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "events": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "event_id": {
                "$ref": "#/$defs/uuid"
              },
              "type": {
                "const": "review_requested"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "card",
                      "sticker",
                      "button"
                    ]
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "event_id",
              "type",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "event_id": {
                "$ref": "#/$defs/uuid"
              },
              "type": {
                "const": "checkin_completed"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "review_id": {
                    "$ref": "#/$defs/uuid"
                  }
                },
                "required": [
                  "review_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "event_id",
              "type",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "event_id": {
                "$ref": "#/$defs/uuid"
              },
              "type": {
                "const": "play_completed"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "game": {
                    "const": "catch_star"
                  },
                  "score": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 15
                  }
                },
                "required": [
                  "game",
                  "score"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "event_id",
              "type",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "event_id": {
                "$ref": "#/$defs/uuid"
              },
              "type": {
                "const": "demo_trigger"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "scenario": {
                    "type": "string",
                    "enum": [
                      "food",
                      "ride",
                      "savings"
                    ]
                  }
                },
                "required": [
                  "scenario"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "event_id",
              "type",
              "payload"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "firmware": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "asset_version": {
          "const": 1
        },
        "uptime_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "rssi_dbm": {
          "type": "integer",
          "minimum": -127,
          "maximum": 0
        }
      },
      "required": [
        "firmware",
        "asset_version",
        "uptime_s",
        "rssi_dbm"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "request_id",
    "device_id",
    "epoch",
    "ack_command_seq",
    "events",
    "telemetry"
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "epoch": {
            "type": "null"
          }
        },
        "required": [
          "epoch"
        ]
      },
      "then": {
        "properties": {
          "ack_command_seq": {
            "const": 0
          },
          "events": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
